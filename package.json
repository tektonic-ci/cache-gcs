{
  "name": "@tektonic-ci/cache-gcs",
  "version": "2.1.0",
  "description": "Google Cloud Storage cache backend and artifact store for tektonic",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/tektonic-ci/cache-gcs.git"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "dist/**/*.js.map",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "npm run typecheck && vitest run",
    "test:watch": "vitest",
    "synth": "npm run build && tektonic synth self-ci.ts",
    "check": "npm run build && tektonic check self-ci.ts",
    "graph": "npm run build && tektonic graph self-ci.ts",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "@tektonic-ci/core": "^2"
  },
  "devDependencies": {
    "@tektonic-ci/core": "^2.1.0",
    "@tektonic-ci/reporter-github": "^2.1.0",
    "@types/node": "^26.0.0",
    "cdk8s": "^2.68.0",
    "constructs": "^10.3.0",
    "typescript": "~7.0.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
